<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">#FF0F1424</item>
        <item name="android:navigationBarColor">#FF0F1424</item>
        <item name="android:windowBackground">#FF0F1424</item>
        <item name="colorPrimary">#FF6C8CFF</item>
        <item name="colorPrimaryDark">#FF0F1424</item>
        <item name="colorAccent">#FF6C8CFF</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
